# Copy this file to .env and add the key for your chosen provider.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Choose "openai" or "gemini".
#LLM_PROVIDER=openai
LLM_PROVIDER=gemini

# Answer-generation models. Update these if your account uses other models.
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-3.8-flash

# Embedding models are configured separately from chat models.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# RAG and generation settings.
TEMPERATURE=0.2
TOP_K=5
# Minimum cosine similarity; useful thresholds still vary by embedding model.
SIMILARITY_THRESHOLD=0.35
CHUNK_SIZE=900
CHUNK_OVERLAP=150
